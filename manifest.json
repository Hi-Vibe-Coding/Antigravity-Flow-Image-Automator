{
  "manifest_version": 3,
  "name": "Antigravity Flow Image Automator",
  "version": "0.3.21",
  "description": "Bulk AI product image enhancement workbench and non-DOM protocol engine for Google Flow.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open Flow Image Automator Workbench",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "tabs",
    "scripting",
    "downloads",
    "notifications"
  ],
  "host_permissions": [
    "https://flow.google.com/*",
    "https://flow-content.google/*",
    "https://*.googleusercontent.com/*",
    "https://labs.google/*",
    "https://aisandbox-pa.googleapis.com/*",
    "https://www.pushplus.plus/*",
    "http://www.pushplus.plus/*",
    "https://sctapi.ftqq.com/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://flow.google.com/*",
        "https://labs.google/fx/*"
      ],
      "js": [
        "content/main-api-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://flow.google.com/*",
        "https://labs.google/fx/*"
      ],
      "js": [
        "content/isolated-relay.js"
      ],
      "run_at": "document_start"
    }
  ]
}
